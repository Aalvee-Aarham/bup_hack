# Comma-separated key pools. Priority: groq -> gemini -> openrouter.
# Every key x model pair is a separate rate budget, so more keys = more throughput.
GROQ_API_KEYS=gsk_key1,gsk_key2
GEMINI_API_KEYS=AIza_key1
OPENROUTER_API_KEYS=sk-or-key1

# Models, most accurate first within each provider (comma-separated overrides)
# GROQ_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-120b,openai/gpt-oss-20b
# GEMINI_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite,gemini-flash-lite-latest
# OPENROUTER_MODELS=deepseek/deepseek-v4-flash-0731:free,qwen/qwen3.8-27b:free,google/gemma-4-31b-it:free

# Starting rate budgets per key per model. Real caps are learned from provider
# headers and 429 bodies at runtime, so these only shape the very first burst.
# GROQ_TPM=8000
# GROQ_RPM=30
# GEMINI_RPM=10
# OPENROUTER_RPM=20

# Latency knobs
# LLM_TOTAL_BUDGET_S=15      whole LLM cascade, then the regex fallback
# LLM_ATTEMPT_TIMEOUT_S=8    one model call; a slow call is retried on another slot
# LLM_HEDGE_AFTER_S=1.5      race a second free slot if the first is this slow
# LLM_MAX_PARALLEL=2         attempts racing for one request
# LLM_PRIORITY_BIAS_S=1.0    seconds a lower provider tier must beat a higher one by
# LLM_MODEL_BIAS_S=1.5       seconds a less accurate model must beat a more accurate one by
# LLM_CACHE_SIZE=20000       interpreted notes kept in memory
# LOG_LEVEL=INFO
